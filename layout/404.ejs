<div class="seihaku-page-container" style="max-width: 680px; margin: 72px auto 96px; text-align: center; padding: 48px 24px;">
  <div class="font-mono" style="font-size: 0.78rem; letter-spacing: 0.24em; color: var(--color-accent); margin-bottom: 12px;">
    404 · PAGE NOT FOUND
  </div>
  <h1 class="font-serif" style="font-size: 2.2rem; font-weight: 700; color: var(--text-primary); margin: 0 0 16px;">
    <%= __('pages.not_found_title') %>
  </h1>
  <p class="font-serif" style="font-size: 0.98rem; color: var(--text-secondary); line-height: 1.85; max-width: 460px; margin: 0 auto 36px;">
    <%= __('pages.not_found_desc') %>
  </p>
  <div style="display: flex; align-items: center; justify-content: center; gap: 14px; flex-wrap: wrap;">
    <a href="<%- url_for('/') %>" class="hero-cta-primary" style="text-decoration: none;">
      <span><%= __('pages.back_to_home') %></span>
      <i class="fas fa-arrow-right" style="font-size: 0.8rem;"></i>
    </a>
    <a href="<%- url_for('/archives') %>" class="hero-cta-secondary" style="text-decoration: none;">
      <i class="fas fa-feather-alt" style="font-size: 0.82rem;"></i>
      <span><%= __('pages.browse_archives') %></span>
    </a>
  </div>
</div>
