<div class="seihaku-page-container">
  <div class="page-header-block">
    <span class="page-eyebrow font-mono">TAGS / <%= __('nav.tags') %></span>
    <h1 class="page-title font-serif"><%= __('pages.tags_title') %></h1>
    <p class="page-subtitle">
      <%= page.description || __('pages.thinking_sub') %> (<%= site.tags.length %>)
    </p>
  </div>

  <!-- 页面用户自定义导言 -->
  <% if (page.content && page.content.trim().length > 0) { %>
    <div class="post-article-card" style="margin-bottom: 32px; max-width: 860px; margin-left: auto; margin-right: auto;">
      <div class="markdown-body">
        <%- page.content %>
      </div>
    </div>
  <% } %>

  <div class="seihaku-tags-cloud-container">
    <% if (site.tags && site.tags.length > 0) { %>
      <% site.tags.forEach(function(tag) { %>
        <a href="<%- url_for(tag.path) %>" class="tag-cloud-card">
          <span class="tag-cloud-hash">#</span>
          <span class="tag-cloud-name"><%= tag.name %></span>
          <span class="tag-cloud-count font-mono"><%= tag.posts.length %></span>
        </a>
      <% }); %>
    <% } else { %>
      <div style="text-align: center; padding: 48px 24px; color: var(--text-tertiary); background: var(--bg-surface-elevated); border: 1px dashed var(--border-subtle); border-radius: var(--radius-xl);">
        <p style="margin: 0; font-size: 0.92rem;"><%= __('stream.empty_writing') %></p>
      </div>
    <% } %>
  </div>
</div>
