<%
  var photosList = (site.data && site.data.photos && site.data.photos.length > 0)
    ? site.data.photos
    : ((theme.photos && theme.photos.list) ? theme.photos.list : []);
%>

<div class="seihaku-page-container">
  
  <div class="page-header-block">
    <span class="page-eyebrow font-mono">GALLERY / <%= __('nav.photos') %></span>
    <h1 class="page-title font-serif"><%= __('pages.photos_title') %></h1>
    <p class="page-subtitle"><%= __('pages.photos_sub') %></p>
  </div>

  <div class="photos-masonry-grid">
    <% if (photosList && photosList.length > 0) { %>
      <% photosList.forEach(function(photo) { %>
        <figure class="photo-card">
          <img src="<%- photo.url %>" alt="<%= photo.title %>" loading="lazy">
          <figcaption class="photo-card-info">
            <div class="photo-title font-serif"><%= photo.title %></div>
            <div class="photo-exif-row">
              <span><%= photo.location %></span>
              <% if (photo.camera) { %>
                <span>·</span>
                <span><%= photo.camera %></span>
              <% } %>
              <% if (photo.exif) { %>
                <span>·</span>
                <span><%= photo.exif %></span>
              <% } %>
            </div>
          </figcaption>
        </figure>
      <% }); %>
    <% } else { %>
      <div style="column-span: all; text-align: center; padding: 48px 24px; color: var(--text-tertiary); background: var(--bg-surface-elevated); border: 1px dashed var(--border-subtle); border-radius: var(--radius-xl);">
        <i class="fas fa-camera" style="font-size: 2.2rem; color: var(--color-accent); margin-bottom: 12px; opacity: 0.6;"></i>
        <p style="margin: 0; font-size: 0.92rem;"><%= __('pages.photos_empty') %></p>
      </div>
    <% } %>
  </div>

  <% if (page.content) { %>
    <div class="post-article-card" style="margin-top: 48px;">
      <div class="markdown-body font-serif">
        <%- page.content %>
      </div>
    </div>
  <% } %>

</div>
