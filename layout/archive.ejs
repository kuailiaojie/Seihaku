<%
  var siteStats = typeof seihaku_site_stats === 'function' ? seihaku_site_stats() : { postCount: site.posts.length, wordsInWan: '0.0' };
  var wordsInWan = siteStats.wordsInWan;
  var postsList = page.posts || site.posts;
%>

<div class="seihaku-page-container">
  
  <div class="page-header-block">
    <span class="page-eyebrow font-mono">ARCHIVES / <%= __('nav.writing') %></span>
    <h1 class="page-title font-serif"><%= __('pages.archive_title') %></h1>
    <p class="page-subtitle">
      <%= __('pages.archive_sub') %> · <strong><%= site.posts.length %></strong> <%= __('hero.stats_posts') %> · <strong><%= wordsInWan %></strong> <%= __('hero.stats_words') %>
    </p>
  </div>

  <div class="archives-library-wrapper">
    
    <!-- 分类快速导引药丸 -->
    <% if (site.categories && site.categories.length > 0) { %>
      <div class="archives-filter-pills">
        <a href="<%- url_for('/archives') %>" class="archive-filter-pill <%= !is_category() ? 'active' : '' %>"><%= __('pages.bangumis_all') %> (<%= site.posts.length %>)</a>
        <% site.categories.forEach(function(cat) { %>
          <a href="<%- url_for(cat.path) %>" class="archive-filter-pill <%= is_category(cat.name) ? 'active' : '' %>">
            <%= cat.name %> (<%= cat.posts.length %>)
          </a>
        <% }); %>
      </div>
    <% } %>

    <!-- 文章卡片列表 -->
    <div class="archives-articles-stack">
      <% if (postsList && postsList.length > 0) { %>
        <% postsList.sort('date', -1).forEach(function(post) { %>
          <%
            var wordCount = post.content ? strip_html(post.content).length : 0;
            var readTime = Math.max(1, Math.round(wordCount / 350));
            var catName = (post.categories && post.categories.length) ? post.categories.data[0].name : __('nav.writing');
          %>
          <a href="<%- url_for(post.path) %>" class="archive-entry-card">
            <div style="flex: 1; min-width: 0; padding-right: 16px;">
              <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                <span class="musing-tag-pill" style="font-size: 0.7rem;"><%= catName %></span>
                <time datetime="<%= date_xml(post.date) %>" style="font-family: var(--font-mono); font-size: 0.76rem; color: var(--text-tertiary);">
                  <%= date(post.date, 'YYYY-MM-DD') %>
                </time>
              </div>
              <div class="archive-entry-title font-serif"><%= post.title || '无题' %></div>
            </div>

            <div class="archive-entry-meta">
              <span><%= readTime %> <%= __('post.read_time_suffix') %></span>
              <span>·</span>
              <span><%= wordCount %> <%= __('post.word_count') %></span>
            </div>
          </a>
        <% }); %>
      <% } else { %>
        <div style="text-align: center; padding: 48px 24px; color: var(--text-tertiary); background: var(--bg-surface-elevated); border: 1px dashed var(--border-subtle); border-radius: var(--radius-xl);">
          <p style="margin: 0; font-size: 0.92rem;"><%= __('stream.empty_writing') %></p>
        </div>
      <% } %>
    </div>

    <!-- 分页导航 -->
    <%- partial('partial/pagination') %>
  </div>

</div>
